# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/appdb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=password

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRY=24h

# API Keys
API_KEY=your-api-key

# WebSocket
SOCKET_IO_PORT=3001
SOCKET_IO_CORS=http://localhost:3000